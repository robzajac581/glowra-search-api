DB_DRIVER='{ODBC Driver 17 for SQL Server}'
DB_SERVER=your_server_here
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
NODE_ENV=production

# Optional: canonical URLs for blog HTML, OG tags, and sitemap (e.g. https://www.glowra.com)
# If unset, the request Host / X-Forwarded-Proto headers are used.
PUBLIC_SITE_URL=

# Optional: Vercel (or other) deploy hook after blog publish/update/delete (see utils/deployWebhook.js)
FE_DEPLOY_HOOK_URL=
# Optional: cap on billable Google Places Photo fetches by the photo proxy (GLO-76).
# Past the limit, the proxy serves stale cache or a 503 placeholder instead of calling Google.
# Defaults: 500 fetches per rolling 24 hours. 0 blocks all Google photo fetches.
GOOGLE_PHOTO_FETCH_LIMIT=
GOOGLE_PHOTO_FETCH_WINDOW_HOURS=

# Required: secret for signing admin JWTs. The server refuses to start without it (GLO-29).
# Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
